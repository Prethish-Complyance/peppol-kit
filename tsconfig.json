    "rootDir": ".",
    "outDir": "./dist",
    "declaration": true,
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "index.ts",
    "core/**/*.ts",
    "example/**/*.ts"
  ]
